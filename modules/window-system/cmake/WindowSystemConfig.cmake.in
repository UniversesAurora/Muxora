@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.9 COMPONENTS Core Gui Widgets)
if(WIN32)
    # The static library prefills Qt's font fallback cache (ADR 0014).
    find_dependency(Qt6 COMPONENTS GuiPrivate)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/WindowSystemTargets.cmake")
check_required_components(WindowSystem)
